# MySQL connection (docker compose up -d starts this database)
DATABASE_URL="mysql://root:root@localhost:3306/subflow"

# Base URL used in password reset links
APP_URL="http://localhost:3000"

# SMTP for password reset emails. Leave SMTP_HOST empty to print reset links to the server console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SubFlow <no-reply@subflow.local>"
